# GITIGNORE template for MATLAB and SIMULINK
# Windows default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Simulink code generation folders
slprj/
sccprj/

# Matlab code generation folders
codegen/

# Simulink autosave extension
*.autosave

# Simulink cache files
*.slxc

# Octave session info
octave-workspace

# Folders
Utilities/
# CarMesh3D: each vehicle's cached stages (remade on demand)
Data/**/cache/

# CarMesh3D: check figures and animations (remade by each vehicle's script;
# the check pictures, .png, stay in the repository)
Data/**/checks/*.fig
Data/**/checks/*.gif

# CarMesh3D: each vehicle's downloaded model (the .glb/.zip/.usdz files,
# textures and Blender's reduced copies). Kept in the IVSG large-file
# storage area and copied in with rclone (see README.md, "Large files").
# Each vehicle's raw mesh, rawMesh_<ID>.mat, stays in the repository, so the
# scripts still run without the downloads.
Data/**/model/

# CarMesh3D: the demo menu's saved answers (written by the DebugTools menu)
Data/answersSoFar_*.mat

# Office lock files, made while a document is open in Word, Excel or
# PowerPoint (one was committed by mistake on 2026-11-23)
~$*

# CarMesh3D: the same for the someday vehicles (DataSomeday, beside Data; see
# DataSomeday/README.md): caches, check figures and animations, downloads
DataSomeday/**/cache/
DataSomeday/**/checks/*.fig
DataSomeday/**/checks/*.gif
DataSomeday/**/model/

# CarMesh3D: the large data (every vehicle's downloaded model, in the same
# layout as Data and DataSomeday), kept in the IVSG large-file storage area
# and copied in by each user (Sean, 2026-11-24; see README.md, "Large files")
LargeData/

# CarMesh3D: the main window's working copies and saved views (per computer,
# never committed; Q110 (A), 2026-11-27; see
# Documents/Documentation_CarMesh3D_GUIdesign_main.md)
Working/
